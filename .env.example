# Signalpost Agent Configuration

# Brønnøysund Register Centre API base URL
BRREG_API_BASE_URL=https://data.brreg.no/enhetsregisteret/api

# SQLite database file path
DATABASE_PATH=data/signalpost.db

# HTTP request timeout in seconds
REQUEST_TIMEOUT_SECONDS=10.0

# User agent string identifying the client
USER_AGENT=SignalpostAgent/0.1.0

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
